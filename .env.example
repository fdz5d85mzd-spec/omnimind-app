# Base URL of the OmniMind control plane API. Defaults to
# https://api.omnimindai.app if unset — only set this to point at a different
# backend (e.g. local dev).
NEXT_PUBLIC_OMNIMIND_API="https://api.omnimindai.app"

# ─── Accounts (NextAuth + Prisma) ──────────────────────────────
# Any Postgres connection string works — e.g. Vercel Postgres/Neon:
# Vercel dashboard → Storage → Create Database → Postgres, then copy the
# connection string it gives you here.
DATABASE_URL="postgresql://user:password@host:5432/omnimind?schema=public"

# Session signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-real-random-secret"
# The deployed site's own URL (no trailing slash).
NEXTAUTH_URL="https://omnimindai.app"

# ─── Master/Admin roles ────────────────────────────────────────
# Whoever signs up with this email gets full admin-dashboard access,
# every session, automatically — no separate approval step. Defaults to
# aristidou.m@outlook.com if unset.
MASTER_EMAIL="aristidou.m@outlook.com"
# A second email with the exact same full admin-dashboard access as
# MASTER_EMAIL (equal co-owners, no read-only tier). Unset by default (no
# second admin) until you provide one.
ADMIN_EMAIL=""

# Shared secret with the OmniMind backend's own ADMIN_API_KEY (set on
# Render). Required for the admin dashboard's Approve/Lockdown buttons to
# actually work — without it, the backend still accepts those calls from
# anyone, which defeats the point of gating them behind sign-in. Generate
# with: openssl rand -base64 32, and set the SAME value on both services.
ADMIN_API_KEY="replace-with-a-real-random-secret"

# ─── Helen (/helen/*) ───────────────────────────────────────────
# The app runs fully on mock/local data with none of these set. Copy from
# the Origoomni repo's own .env.local once you have real accounts — see
# that repo's docs/GOING-LIVE.md for the full setup walkthrough.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
ANTHROPIC_API_KEY=""
ELEVENLABS_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Shared secret checked by /helen/api/cron/inactivity-reminder before it
# runs — set this to whatever value the Vercel Cron job is configured to
# send, so the endpoint can't be triggered by anyone who finds the URL.
CRON_SECRET=""
