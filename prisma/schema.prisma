generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  creditBalance Int       @default(200) @map("credit_balance")
  plan          String    @default("free")
  cooldownUntil DateTime? @map("cooldown_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts    Account[]
  sessions    Session[]
  usageEvents UsageEvent[]
  voxProjects VoxProject[]
  connections UserConnection[]

  @@map("users")
}

// A user's own API key for another provider ("bring your own key") --
// stored encrypted (see lib/connectorCrypto.ts), never in plaintext.
// When present, chat requests use this key/provider instead of OmniMind's
// own shared one, and aren't charged against the user's credit balance
// (they're spending their own provider quota, not ours).
model UserConnection {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  provider     String // "openai" for now
  encryptedKey String   @map("encrypted_key") @db.Text
  maskedKey    String   @map("masked_key") // e.g. "sk-...ab3f", for display only
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_connections")
}

model UsageEvent {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  runId       String   @map("run_id")
  chars       Int
  durationMs  Int      @map("duration_ms")
  creditsCost Int      @map("credits_cost")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_events")
}

model CostSettings {
  id          String   @id @default("singleton")
  items       Json     @default("[]")
  marginPct   Float    @default(40)
  subscribers Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cost_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------- VoxStudio
// The native, OmniMind-hosted rebuild of VoxAvatar's product surface. The
// original voxavatar.xyz generation pipeline runs through an internal-only
// Higgsfield hostname (fnf.internal) that isn't reachable outside their own
// network, so this is a from-scratch rebuild, not a code port -- it starts
// with pre-production (Director Agent creative briefs, on the Anthropic key
// already configured for the rest of OmniMind) and grows adapters for real
// image/video/voice generation as those provider keys are added.
model VoxProject {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  idea      String   @db.Text
  title     String
  logline   String   @db.Text
  status    String   @default("briefed") // briefed | in_production | complete
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters VoxCharacter[]
  scenes     VoxScene[]
  jobs       VoxJob[]

  @@map("vox_projects")
}

model VoxCharacter {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  project VoxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("vox_characters")
}

model VoxScene {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  order       Int
  heading     String
  description String   @db.Text
  shots       Json     @default("[]") // ordered shot list: {camera, action} per shot
  createdAt   DateTime @default(now()) @map("created_at")

  project VoxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("vox_scenes")
}

// One row per generation request a finished production would need (image,
// video, voice, music per scene/character). Created with status
// "not_configured" until a real provider adapter exists for `kind` -- the
// row is the honest record of "this would be a job" even before anything
// can actually run it.
model VoxJob {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  kind      String // "image" | "video" | "voice" | "music"
  status    String   @default("not_configured") // not_configured | queued | running | completed | failed
  input     Json     @default("{}")
  output    Json?
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project VoxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("vox_jobs")
}

// ---------------------------------------------------------------- Partners
// Admin-managed referral partners. Attribution itself lives in Stripe, not
// a join table here: a referred checkout carries { ref_code: <code> } in
// the Checkout Session's metadata (see app/helen/api/checkout,
// shop-checkout), so commission owed is computed by summing real Stripe
// charges tagged with a partner's code -- never a guess, never a separate
// number that could drift from what Stripe actually shows.
model Partner {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  referralCode  String   @unique @map("referral_code")
  commissionPct Float    @default(20) @map("commission_pct")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("partners")
}
